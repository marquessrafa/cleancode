<Project Sdk="Microsoft.NET.Sdk">
  <!-- Helper de sensores do CleanCode no Windows: usa a LibreHardwareMonitorLib (MPL 2.0) e escreve JSON.
       .NET Framework 4.7.2 já vem no Windows 10/11, então não é preciso instalar runtime. -->
  <PropertyGroup>
    <!-- WinExe: sem janela de console (a tarefa agendada roda na sessão do usuário); a saída por pipe continua funcionando -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>cc-lhm</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- a LibreHardwareMonitorLib traz a DLL por arquitetura (runtimes/win-x64/lib/net472):
         sem RuntimeIdentifier ela não é copiada. O app sai só em x64 (no ARM64 roda emulado). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- copia a LibreHardwareMonitorLib e as dependências dela para a pasta do exe -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
